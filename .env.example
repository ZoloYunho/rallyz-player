# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy anon key also works
# if you name it NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of the site, used for sign-in redirects and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production only: share the sign-in with the main site (same Supabase project).
# The main site must use the same cookie domain. Leave empty on localhost.
NEXT_PUBLIC_COOKIE_DOMAIN=
# The main site with court search, linked as "Courts" in the header.
NEXT_PUBLIC_MAIN_SITE_URL=https://rallyz.club
